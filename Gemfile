# The document toolchain, pinned so a local render and CI's use the same
# Asciidoctor. Install with `bundle install`; the render runs `bundle exec`.
source "https://rubygems.org"

gem "asciidoctor", "2.0.26"
gem "asciidoctor-pdf", "2.3.27"
# Ruby 3.5 and later ship logger as a bundled gem rather than a default one,
# so under bundler it must be named here for Asciidoctor to load it.
gem "logger", "1.7.0"
