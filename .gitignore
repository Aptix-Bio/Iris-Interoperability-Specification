# Build trees (CMakePresets.json writes build/<preset>).
/build/

# Fetched dependencies (Catch2), pinned by hash in CMakeLists.txt.
/dependencies

# uv's project-local environment.
/.venv/
__pycache__/
.mypy_cache/
.pytest_cache/

.DS_Store

# Generated C++ and documentation: regenerated by generator/ from spec/*.json
# at configure time. Each folder's README.md is documentation, kept committed.
generated_source/*
!generated_source/README.md
generated_docs/*
!generated_docs/README.md

# Bundler's local settings and installed gems, when installed into the tree.
/.bundle/
/vendor/

# IDE state.
/.idea/
