{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug (build/debug)",
      "description": "Ninja, Debug, tests on; regenerates generated_source/ and generated_docs/ at configure.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "I2S_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (build/release)",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gates",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "stopOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "gates",
      "displayName": "Gates: lint, generator check, tests, document",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "gates"
        }
      ]
    }
  ]
}
